# Shared local development template.
# Copy these keys into .env.local and fill real values there.

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="internship_management_system"
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="admin123"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship_management_system"

APP_BASE_URL="http://localhost:3000"
AUTH_SECRET="dev-auth-secret-change-me"
SEED_LOGIN_PASSWORD="Password123!"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

CMU_ENTRA_TENANT_ID=""
CMU_ENTRA_CLIENT_ID=""
CMU_ENTRA_CLIENT_SECRET=""
CMU_ENTRA_SCOPE="api://cmu/Mis.Account.Read.Me.Basicinfo offline_access"
CMU_ENTRA_CALLBACK_PATH="/intern/api/auth/callback"
CMU_ENTRA_AUTHORIZE_URL=""
CMU_ENTRA_TOKEN_URL=""
